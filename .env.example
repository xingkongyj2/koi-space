# Koi model configuration
# Copy this file to .env and fill in the API keys.

# Planner: any OpenAI-compatible chat endpoint.
# Qwen example:
KOI_PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KOI_PLANNER_API_KEY=sk-your-qwen-key
KOI_PLANNER_MODEL=qwen-plus
KOI_PLANNER_TIMEOUT=45

# Kimi example (replace the three values above when using Kimi):
# KOI_PLANNER_BASE_URL=https://api.moonshot.cn/v1
# KOI_PLANNER_API_KEY=sk-your-kimi-key
# KOI_PLANNER_MODEL= kimi-k2.5

# OpenAI example:
# KOI_PLANNER_BASE_URL=https://api.openai.com/v1
# KOI_PLANNER_API_KEY=sk-your-openai-key
# KOI_PLANNER_MODEL=gpt-4o-mini

# Decision: Jev typed browser decision endpoint.
KOI_DECISION_BASE_URL=https://api.typesafe.ai/v1
KOI_DECISION_API_KEY=ts-your-typesafe-key
KOI_DECISION_MODEL=jev-latest
KOI_DECISION_TIMEOUT=10

# Persistent task memory and reusable skills.
KOI_MEMORY_PATH=~/.koi/memory.jsonl
KOI_SKILLS_PATH=~/.koi/skills.jsonl

# Runtime circuit breaker.
KOI_MAX_STEPS=30
KOI_MAX_FAILURES=3
KOI_MAX_SECONDS=300

# Optional alternate env file path.
# KOI_ENV_FILE=/absolute/path/to/koi.env
