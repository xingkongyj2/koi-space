# 复制为 .env。所有模型统一使用 OpenAI Responses 兼容协议。
KOI_PLANNER_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
KOI_PLANNER_MODEL=qwen3.8-flash
KOI_PLANNER_API_KEY=你的Planner_API_Key
KOI_DECISION_BASE_URL=https://api.typesafe.ai/v1
KOI_DECISION_MODEL=jev-latest
KOI_DECISION_API_KEY=你的Decision_API_Key
KOI_MAX_STEPS=30
KOI_MAX_FAILURES=3
KOI_MAX_SECONDS=300
KOI_MEMORY_PATH=~/.koi/memory.jsonl
KOI_SKILLS_PATH=~/.koi/skills.jsonl
