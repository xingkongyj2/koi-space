# Copy to ~/.koi/config.toml and fill keys.
memory_path = "~/.koi/memory.jsonl"
[planner]
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1" # Kimi/OpenAI compatible URL also works
api_key = "sk-..."
model = "qwen-plus"
timeout = 45
[decision]
base_url = "https://api.typesafe.ai/v1"
api_key = "ts-..."
model = "jev-latest"
timeout = 10
