#!/bin/sh
# agent-browser shim — stands in for the real CLI on the agent's PATH.
#
# agent-browser binds a session to one of the browser's tabs and keeps that
# binding in a per-session daemon. When the daemon exits (idle timeout, crash,
# machine sleep) the binding is lost and the next command silently reattaches
# to t1 — which, in an app running up to 10 concurrent browser views on a
# single CDP port, is another session's page. So before forwarding we check
# whether the daemon pid changed and re-resolve the binding if it did.
#
# Fast path costs two file reads. Everything lives in shim.env because POSIX sh
# has no JSON parser.

set -u

if [ -z "${BU_AGENT_BROWSER_SHIMENV:-}" ] || [ ! -f "$BU_AGENT_BROWSER_SHIMENV" ]; then
  echo "agent-browser: BU_AGENT_BROWSER_SHIMENV is missing or unreadable." >&2
  echo "This command only works inside an app-spawned agent session." >&2
  exit 127
fi

# shellcheck disable=SC1090
. "$BU_AGENT_BROWSER_SHIMENV"

if [ -n "${BU_AGENT_BROWSER_MISSING:-}" ]; then
  echo "agent-browser is not installed on this machine." >&2
  echo "Install it with: npm install -g agent-browser" >&2
  exit 127
fi

current_pid=$(cat "$AB_PIDFILE" 2>/dev/null) || current_pid=""
cached_pid=$(cat "$AB_CACHE" 2>/dev/null) || cached_pid=""

# A pid-file match alone is not enough. A daemon that was SIGKILLed (crash,
# logout, `kill`) leaves its pid file behind with the old pid still in it, so
# the cache would compare equal while no daemon is running — the next command
# would spawn a fresh one bound to t1. Require the pid to be live as well.
pid_alive() {
  [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

if [ ! -f "$AB_CACHE" ] || [ "$current_pid" != "$cached_pid" ] || ! pid_alive "$current_pid"; then
  ELECTRON_RUN_AS_NODE=1 "$AB_ELECTRON" "$AB_REBIND" || exit $?
fi

exec "$AB_BIN" "$@"
